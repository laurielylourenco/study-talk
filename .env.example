TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/estudobot.db
APP_ENV=development

# Só esses telegram_id usam o bot (vírgula se tiver mais de um)
ALLOWED_TELEGRAM_IDS=123

LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Modelo legado (fallback)
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelos por tarefa (free tier)
GEMINI_MODEL_MULTIMODAL=gemini-3.5-flash-lite
GEMINI_MODEL_TEXT_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_SUMMARY=gemini-3.5-flash-lite
GEMINI_MODEL_QUESTIONS=gemini-3.7-flash
GEMINI_MODEL_REASONING=gemini-3.5-flash
